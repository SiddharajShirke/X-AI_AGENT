# -----------------------------------------------------------------------------
# Startup X Agent prototype
# Copy this file to .env. Demo mode works without any external credentials.
# Never commit the real .env file.
# -----------------------------------------------------------------------------
APP_NAME="Startup X Agent"
# Demo is credential-free. APP_MODE describes deployment intent and warnings;
# it does not gate Buffer publication. Keep Buffer's separate switch off unless
# the staged live checks in docs/DEPLOYMENT.md are complete.
APP_MODE=demo
DATABASE_PATH=./data/x_agent.db
# For Slack HTTP Interactivity, set this to the exact stable HTTPS public origin.
# Changing this origin requires updating the Slack Interactivity Request URL.
BASE_URL=http://localhost:8000

# Change these before putting the prototype on a public URL. Keep both secrets
# stable: changing the encryption key locks saved credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
APP_ENCRYPTION_KEY=
APP_CSRF_SECRET=

SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=20
SLACK_ACTION_WORKER_ENABLED=true
SLACK_ACTION_POLL_SECONDS=1
SLACK_ACTION_LEASE_SECONDS=300
MAX_GENERATION_CANDIDATES=5
RSS_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Groq content generation
# Set GROQ_API_KEY to enable live Groq generation.
# Without GROQ_API_KEY the deterministic credential-free DemoWriter is used.
# The model ID contains the "openai/" prefix but is hosted and called through
# Groq — do not create an OpenAI client.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# X trend research (optional)
# TWITTER_BEARER_TOKEN is used ONLY for X recent-search trend collection.
# It is NOT used for publishing. Publishing goes through Buffer.
# ---------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Buffer publishing. API keys and per-account channel IDs are added through
# the encrypted Connections and Account Setup dashboards, not this file.
# Both this global switch and the account's LIVE switch enable publication,
# even when APP_MODE=demo. Keep this false until staged checks are complete.
# ---------------------------------------------------------------------------
# Deprecated compatibility safety flag. It has no enabling effect and remains false.
X_LIVE_POSTING=false
BUFFER_LIVE_POSTING=false
BUFFER_API_URL=https://api.buffer.com
BUFFER_TIMEOUT_SECONDS=30
BUFFER_SHARE_MODE=shareNow

# ---------------------------------------------------------------------------
# Optional Telegram review channel.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# ---------------------------------------------------------------------------
# Slack webhooks and signing secrets are encrypted through the Connections
# dashboard. Do not put them in this file.
# ---------------------------------------------------------------------------
