# -----------------------------------------------------------------------------
# Startup X Agent prototype
# Copy this file to .env. Demo mode works without any external credentials.
# Never commit the real .env file.
# -----------------------------------------------------------------------------
APP_NAME="Startup X Agent"
APP_MODE=demo
DATABASE_PATH=./data/x_agent.db
BASE_URL=http://localhost:8000

# Change these before putting the prototype on a public URL.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=20
MAX_GENERATION_CANDIDATES=5
RSS_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Groq content generation
# Set GROQ_API_KEY to enable live Groq generation.
# Without GROQ_API_KEY the deterministic credential-free DemoWriter is used.
# The model ID contains the "openai/" prefix but is hosted and called through
# Groq — do not create an OpenAI client.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# X trend research (optional)
# TWITTER_BEARER_TOKEN is used ONLY for X recent-search trend collection.
# It is NOT used for publishing. Publishing goes through Buffer.
# ---------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Buffer publishing
# BUFFER_API_KEY authenticates the Buffer GraphQL API.
# BUFFER_CHANNEL_ID identifies the connected X channel inside Buffer.
#   Without BUFFER_LIVE_POSTING=true and both BUFFER_API_KEY and
#   BUFFER_CHANNEL_ID, DryRunPublisher remains active (safe default).
# BUFFER_API_KEY alone is not enough — BUFFER_CHANNEL_ID is also required.
# Buffer handles the final X publication; the application never calls X
# directly when publishing.
# The prototype publishes text-only posts (no media, no threads).
# Live Buffer reconciliation and media upload are out of scope.
# ---------------------------------------------------------------------------
BUFFER_LIVE_POSTING=false
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
BUFFER_API_URL=https://api.buffer.com
BUFFER_TIMEOUT_SECONDS=30
BUFFER_SHARE_MODE=shareNow

# ---------------------------------------------------------------------------
# Optional Telegram review channel.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# ---------------------------------------------------------------------------
# Optional Slack incoming webhook. Slack sends reviewers back to the dashboard.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
